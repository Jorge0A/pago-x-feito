# Root .env — local secrets for scripts (db push, seed, env sync). Never commit the real file.
# Copy to .env and fill in. `pnpm env:sync` writes apps/web/.env.local from these values.

GITHUB_REPO_URL=

# Supabase — pxf-dev (South America / São Paulo, sa-east-1)
SUPABASE_DEV_URL=
SUPABASE_DEV_ANON_KEY=
SUPABASE_DEV_SERVICE_ROLE_KEY=
SUPABASE_DEV_DB_PASSWORD=

# Supabase — pxf-prod (South America / São Paulo, sa-east-1)
SUPABASE_PROD_URL=
SUPABASE_PROD_ANON_KEY=
SUPABASE_PROD_SERVICE_ROLE_KEY=
SUPABASE_PROD_DB_PASSWORD=

# Anthropic (key created inside a workspace with a US$ 20 monthly limit)
ANTHROPIC_API_KEY=

# Resend (free tier sends only to the account owner's address until a domain is verified)
RESEND_API_KEY=
OWNER_EMAIL=

# Shared secret the Vercel cron sends to /api/cron/* (any long random string)
CRON_SECRET=
